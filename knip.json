{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "docs/**/*.mdx",
        "i18n/**/*.mdx",
        "src/pages/**/*.{ts,tsx,mdx}",
        "src/theme/**/*.{ts,tsx}",
        "scripts/*.ts"
    ],
    "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,tsx}"],
    "ignore": ["src/@types/**"],
    "vitest": {
        "entry": ["tests/**/*.test.{ts,tsx}", "vitest.config.ts"]
    },
    "ignoreExportsUsedInFile": true,
    "tags": ["-knipignore"]
}
