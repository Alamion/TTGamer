{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": [
        "docs/**/*.mdx",
        "i18n/**/*.mdx",
        "src/pages/**/*.{ts,tsx,mdx}",
        "src/theme/**/*.{ts,tsx}",
        "scripts/*.ts"
    ],
    "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,tsx}", "tests-e2e/**/*.ts"],
    "playwright": {
        "config": ["playwright.config.ts"],
        "entry": ["tests-e2e/**/*.spec.ts"]
    },
    "vitest": {
        "entry": ["tests/**/*.test.{ts,tsx}", "vitest.config.ts"]
    },
    "ignoreExportsUsedInFile": true,
    "tags": ["-knipignore"]
}
