{
    "name": "ttgamer",
    "packageManager": "yarn@1.22.22",
    "version": "3.4.0",
    "private": true,
    "scripts": {
        "docusaurus": "docusaurus",
        "build:styles": "sass --no-source-map src/css/tailwind-base-reset.scss src/css/tailwind-base-reset.css && sass --no-source-map src/css/set_tailwind_styles.scss src/css/set_tailwind_styles.css && prettier --write src/css/tailwind-base-reset.css src/css/set_tailwind_styles.css",
        "build:translations": "node --import tsx scripts/build-translations.ts",
        "prestart": "yarn build:styles && yarn build:translations",
        "start": "docusaurus start",
        "prebuild": "yarn build:styles && yarn build:translations && yarn validate:data && yarn validate:i18n && yarn check:version",
        "build": "docusaurus build",
        "swizzle": "docusaurus swizzle",
        "deploy": "docusaurus deploy",
        "clear": "docusaurus clear",
        "serve": "docusaurus serve",
        "write-translations": "docusaurus write-translations",
        "write-heading-ids": "docusaurus write-heading-ids",
        "typecheck": "tsc && tsc -p tsconfig.test.json",
        "lint": "eslint . && prettier --check .",
        "lint:fix": "eslint . --fix && prettier --write .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "validate:data": "node --import tsx scripts/validate-data.ts",
        "validate:i18n": "node --import tsx scripts/validate-i18n.ts && node --import tsx scripts/validate-translations.ts",
        "i18n:status": "node --import tsx scripts/translation-status.ts",
        "check:version": "node --import tsx scripts/check-version.ts",
        "verify:fast": "yarn lint && yarn typecheck",
        "verify": "yarn verify:fast && yarn test",
        "verify:full": "yarn verify && yarn build"
    },
    "dependencies": {
        "@docusaurus/core": "3.10.1",
        "@docusaurus/preset-classic": "3.10.1",
        "@mdx-js/react": "^3.0.0",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-popover": "^1.1.16",
        "@tanstack/react-table": "^8.21.3",
        "cannon-es": "^0.20.0",
        "clsx": "^2.0.0",
        "cmdk": "^1.1.1",
        "localforage": "^1.10.0",
        "lucide-react": "^0.468.0",
        "moo": "^0.5.3",
        "prism-react-renderer": "^2.3.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-hot-toast": "^2.6.0",
        "three": "^0.184.0",
        "zod": "^3.24.0",
        "zustand": "^5.0.0"
    },
    "devDependencies": {
        "@docusaurus/faster": "3.10.1",
        "@docusaurus/module-type-aliases": "3.10.1",
        "@docusaurus/plugin-client-redirects": "3.10.1",
        "@docusaurus/tsconfig": "3.10.1",
        "@docusaurus/types": "3.10.1",
        "@eslint/js": "^10.0.1",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/react": "^16.3.0",
        "@types/moo": "^0.5.10",
        "@types/node": "^24.12.3",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.2.3",
        "@types/three": "^0.184.1",
        "@vitest/coverage-v8": "4.1.8",
        "autoprefixer": "^10.4.23",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "jsdom": "^26.1.0",
        "postcss": "^8.5.6",
        "prettier": "^3.4.0",
        "sass": "^1.89.0",
        "tailwindcss": "^3.4.17",
        "tsx": "^4.20.0",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.59.2",
        "vitest": "^4.1.8",
        "yaml": "^2.9.0"
    },
    "browserslist": {
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 3 chrome version",
            "last 3 firefox version",
            "last 5 safari version"
        ]
    },
    "engines": {
        "node": ">=20.0"
    }
}
